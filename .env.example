# Seznam-autobusu.cz Proxy Configuration
# Copy this file to .env and configure according to your needs

# Server Configuration
# Port the proxy server will listen on
PORT=3000

# Node Environment (production, development)
NODE_ENV=production

# Security
# Secret key for signing session cookies (CHANGE THIS!)
# If NODE_ENV=production and this is left at its default/placeholder value,
# the server refuses to start rather than run with an insecure secret.
COOKIE_SECRET=your-secret-key-here-change-me

# Proxies Configuration
# Comma-separated list of proxies in format host:port:username:password.
# Any provider works here (Webshare, Bright Data, your own, etc.) - each one
# just gets checked for a Czech IP and added to the rotation pool if it passes.
# Example:
# PROXIES=proxy1.example.com:1080:user1:pass1,proxy2.example.com:1080:user2:pass2
PROXIES=

# Webshare Proxy List "Download" URL (Optional)
# Webshare lets you generate a pre-authenticated URL (under Proxy > List >
# Download Code) that returns your current proxy list as plain text
# (host:port:username:password per line) - no API key/auth header needed,
# the token is baked into the URL itself. If set, this is fetched on every
# health check and merged with PROXIES.
# WEBSHARE_PROXY_URL=https://proxy.webshare.io/api/v2/proxy/list/download/<token>/-/any/username/backbone/-/

# Discord Webhook Alerting (Optional)
# If set, a message is posted here whenever the Czech proxy pool drops to 0
# (either after a full health check or after a proxy is auto-blacklisted for
# repeated failures). Alerts are throttled to at most once per 15 minutes.
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Upstream Proxy Configuration (Optional)
# Only needed if running on VPS outside Czech Republic
# Leave empty if running on server with Czech IP address

# Example for HTTP proxy:
# UPSTREAM_PROXY=http://username:password@proxy.example.com:8080

# Example for SOCKS5 proxy:
# UPSTREAM_PROXY=socks5://username:password@proxy.example.com:1080

# Leave empty for direct connection (home server with Czech IP):
UPSTREAM_PROXY=

# Caddy Configuration (if using Caddy reverse proxy)
# Domain name for the proxy
# DOMAIN=your-domain.example
