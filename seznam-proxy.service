[Unit]
Description=Seznam-autobusu.cz Proxy Server
Documentation=https://github.com/yourusername/claude-proxy-sa
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/claude-proxy-sa
Environment=NODE_ENV=production
EnvironmentFile=/root/claude-proxy-sa/.env
ExecStart=/usr/bin/node /root/claude-proxy-sa/server.js
Restart=on-failure
RestartSec=10
StandardOutput=append:/var/log/seznam-proxy/access.log
StandardError=append:/var/log/seznam-proxy/error.log

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/root/claude-proxy-sa

# Performance settings
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
